{
  "name": "@rackula/api",
  "version": "26.10.1",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:worker": "wrangler dev",
    "start": "bun src/index.ts",
    "test": "node ../scripts/build-mcpflow-normalizer.mjs && bun test",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "build:worker": "node ../scripts/build-mcpflow-normalizer.mjs && wrangler deploy --dry-run --outdir dist-worker",
    "typecheck": "node ../scripts/build-mcpflow-normalizer.mjs && tsc --noEmit"
  },
  "overrides": {
    "defu": "^6.1.5",
    "postcss": "^8.5.18"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "~1.6.33",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "js-yaml": "^4.3.2",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@types/bun": "^1.4.2",
    "@types/js-yaml": "^4.0.9",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.11",
    "wrangler": "^4.149.0"
  }
}
